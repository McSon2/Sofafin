*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/
Packages/*/Package.resolved

# Divers
*.log

# Signature : chacun la sienne, jamais dans le dépôt
Signing.local.xcconfig

# Produits de distribution (recréés par xcodebuild)
*.xcarchive
*.ipa
